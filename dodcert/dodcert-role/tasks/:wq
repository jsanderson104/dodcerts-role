---
- name: Copy Certutil import script for /etc/pki/nssdb to host
  ansible.builtin.copy:
    src: update_etcpki_nssdb.bash
    dest: "{{cert_workingdir_intermediates}}"

- name: Update /etc/pki/nssdb with Certs
  loop: "{{renamed_intermediate_files.files}}"
  ansible.builtin.shell: "bash {{cert_workingdir_intermediates}}/update_etcpki_nssdb.bash /etc/pki/nssdb {{item.path}}"
  register: import_cmd
