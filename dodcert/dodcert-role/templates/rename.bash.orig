#!/bin/bash
for file in *.crt; do
  [ -e "$file" ] || continue
  subject=$(openssl x509 -noout -subject -in "$file")
  cn=$(echo "$subject" | sed -n 's/.*CN[[:space:]]*=[[:space:]]*\([^/]*\).*/\1/p')
  if [ -n "$cn" ]; then
    safe_name=$(echo "$cn" | tr ' ' '_')
    mv "$file" "${safe_name}.pem"
    echo "Renamed $file to ${safe_name}.crt"
  else
    echo "Could not find CN in $file"
  fi
done

